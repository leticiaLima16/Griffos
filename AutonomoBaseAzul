package All.Tests.GRIFFOS;

import com.qualcomm.robotcore.eventloop.opmode.Autonomous;
import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
import com.qualcomm.robotcore.hardware.DcMotor;
import com.qualcomm.robotcore.hardware.DcMotorSimple;

@Autonomous(name = "Autonomo Base Azul")
public class AutonomoBaseAzul extends LinearOpMode {

    private DcMotor LMF, RMF, LMB, RMB, intake;
    public static final double CIRCUNFERENCIA_RODA_CM = 23.56;

    // POTÊNCIA
    public static final double power_FRONT = 1.0;
    public static final double power_STRAFE = 1.0;

    // CALIBRAÇÃO
    public static final double MS_POR_CM_FRONT = 5.10;
    public static final double MS_POR_CM_STRAFE = 0,0153; //30% de 5.10
    public static final long   TIME_INTAKE_MS  = 20;
    public static final long   TIME_OUTTAKE_MS  = 20;

    @Override
    public void runOpMode() {
        startHardware();
        waitForStart();
        resetRuntime();

        if (opModeIsActive()) {
            executarRotina();
        }
    }

    // INICIALIZAÇÃO
    private void startHardware() {
        LMF = hardwareMap.get(DcMotor.class, "LMF");
        RMF = hardwareMap.get(DcMotor.class, "RMF");
        LMB = hardwareMap.get(DcMotor.class, "LMB");
        RMB = hardwareMap.get(DcMotor.class, "RMB");
        intake = hardwareMap.get(DcMotor.class, "intake");

        LMF.setDirection(DcMotorSimple.Direction.REVERSE);
        RMF.setDirection(DcMotorSimple.Direction.REVERSE);
        LMB.setDirection(DcMotorSimple.Direction.FORWARD);
        RMB.setDirection(DcMotorSimple.Direction.FORWARD);

        for (DcMotor motor : new DcMotor[]{LMF, RMF, LMB, RMB}) {
            motor.setZeroPowerBehavior(DcMotor.ZeroPowerBehavior.FLOAT);
        }
    }

    // ROTINA (ORDEM DE MOVIMENTOS)
    private void executarRotina() {
        strafeRight(76);
        sleep(300);

        front(76);
        sleep(300);

        strafeleft(172);
        sleep(300);

        front(227);
        sleep(300);

        takeCargo();
        sleep(300);

        back(228);
        sleep(300);

        strafeleft(78);
        sleep(300);

        depositCargo();
        sleep(300);

        strafeleft(100);
        sleep(300);

        front(250);
        sleep(300);

        parar();
    }

    // MOVIMENTO
    private void front(double distanciaCm) {
        mover(power_FRONT, power_FRONT, power_FRONT, power_FRONT,
                (long) (distanciaCm * MS_POR_CM_FRONT));
    }

    private void back(double distanciaCm) {
        mover(-power_FRONT, -power_FRONT, -power_FRONT, -power_FRONT,
                (long) (distanciaCm * MS_POR_CM_FRONT));
    }

    private void strafeRight(double distanciaCm) {
        mover(-power_STRAFE, power_STRAFE, power_STRAFE, -power_STRAFE,
                (long) (distanciaCm * MS_POR_CM_STRAFE));
    }

    private void strafeleft(double distanciaCm) {
        mover(power_STRAFE, -power_STRAFE, -power_STRAFE, power_STRAFE,
                (long) (distanciaCm * MS_POR_CM_STRAFE));
    }

    private void mover(double lmf, double rmf, double lmb, double rmb, long timeMs) {
        setPower(lmf, rmf, lmb, rmb);
        sleep(timeMs);
        parar();
    }

    private void stop() {
        setPower(0, 0, 0, 0);
    }

    //  INTAKE
    private void takeCargo() {
        intake.setPower(1.0);
        sleep(TIME_INTAKE_MS);
        intake.setPower(0);
    }

    private void depositCargo() {
        intake.setPower(-1.0);
        sleep(TIME_OUTTAKE_MS);
        intake.setPower(0);
    }
